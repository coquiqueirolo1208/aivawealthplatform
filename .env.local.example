# Copy to .env.local and fill in (Supabase Dashboard -> Settings -> API / Database).
# .env.local is gitignored — never commit real keys.

# Used by the Next.js app (client + server components). The publishable key is
# Supabase's current name for what used to be called the "anon key" — safe to
# expose client-side, RLS still applies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by Next.js API routes that need elevated access, and by the
# scripts/seed-*.mjs scripts to bypass RLS when loading catalog/demo data.
SUPABASE_SERVICE_ROLE_KEY=
# Same value as NEXT_PUBLIC_SUPABASE_URL — kept separate because the seed scripts
# run outside Next.js and don't read NEXT_PUBLIC_* vars.
SUPABASE_URL=
# Settings -> Database -> Connect -> "Transaction pooler" URI (fill in the
# password). Only needed to apply migrations directly via scripts/run-migrations.mjs.
SUPABASE_DB_URL=

# Optional for now: until this is set, /api/ai/* routes return mocked responses.
ANTHROPIC_API_KEY=

# Optional: SMTP server for the Monday-morning weekly summary email. Until
# SMTP_HOST/SMTP_USER/SMTP_PASSWORD are all set, /api/cron/weekly-summary just
# logs what it would have sent instead of actually sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional — defaults to SMTP_USER if unset.
SMTP_FROM=
# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# triggering /api/cron/weekly-summary — set this in production so the endpoint
# can't be triggered by anyone who finds the URL. Safe to leave unset locally.
CRON_SECRET=
# Base URL used for the "ver en la plataforma" link inside the weekly email.
NEXT_PUBLIC_APP_URL=
