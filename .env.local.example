# Copy to .env.local and fill in (Supabase Dashboard -> Settings -> API / Database).
# .env.local is gitignored — never commit real keys.

# Used by the Next.js app (client + server components). The publishable key is
# Supabase's current name for what used to be called the "anon key" — safe to
# expose client-side, RLS still applies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by Next.js API routes that need elevated access, and by the
# scripts/seed-*.mjs scripts to bypass RLS when loading catalog/demo data.
SUPABASE_SERVICE_ROLE_KEY=
# Same value as NEXT_PUBLIC_SUPABASE_URL — kept separate because the seed scripts
# run outside Next.js and don't read NEXT_PUBLIC_* vars.
SUPABASE_URL=
# Settings -> Database -> Connect -> "Transaction pooler" URI (fill in the
# password). Only needed to apply migrations directly via scripts/run-migrations.mjs.
SUPABASE_DB_URL=

# Optional for now: until this is set, /api/ai/* routes return mocked responses.
ANTHROPIC_API_KEY=
